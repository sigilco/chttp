{
  "name": "@chttp/static",
  "version": "0.4.0",
  "description": "Static asset serving for chttp, authored inside the scriptc compilable subset",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sigilco/chttp.git",
    "directory": "packages/static"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/static.test.js"
  },
  "peerDependencies": {
    "@chttp/router": "workspace:^"
  },
  "devDependencies": {
    "@chttp/router": "workspace:^",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Joaquin Terrasa & contributors",
  "keywords": [
    "static",
    "assets",
    "spa",
    "http",
    "scriptc",
    "native"
  ],
  "homepage": "https://github.com/sigilco/chttp/tree/main/packages/static#readme",
  "bugs": {
    "url": "https://github.com/sigilco/chttp/issues"
  },
  "sideEffects": false
}
