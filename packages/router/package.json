{
  "name": "@chttp/router",
  "version": "0.3.0",
  "description": "Minimal async-first HTTP router authored inside the scriptc compilable subset",
  "keywords": [
    "aot",
    "http",
    "native",
    "node",
    "router",
    "router-http",
    "scriptc"
  ],
  "homepage": "https://github.com/sigilco/chttp#readme",
  "bugs": {
    "url": "https://github.com/sigilco/chttp/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sigilco/chttp.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./src/index.ts": "./src/index.ts",
    "./package.json": "./package.json",
    "./client": {
      "types": "./dist/esm/client.d.ts",
      "import": "./dist/esm/client.js"
    },
    "./src/client.ts": "./src/client.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/router.test.js test/server.test.js test/async.test.js test/upgrade.test.js test/fetch-passthrough.test.js test/client.test.js test/genfetch.test.js && bash test/elf.test.sh"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Joaquin Terrasa & contributors",
  "sideEffects": false
}
