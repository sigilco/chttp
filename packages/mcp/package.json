{
  "name": "@chttp/mcp",
  "version": "0.3.0",
  "description": "Model Context Protocol server (JSON-RPC 2.0) mounted as a chttp route, authored inside the scriptc compilable subset",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sigilco/chttp.git",
    "directory": "packages/mcp"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./client": {
      "types": "./dist/esm/client/index.d.ts",
      "import": "./dist/esm/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test test/*.test.js && bash test/elf.test.sh"
  },
  "devDependencies": {
    "@chttp/router": "workspace:^",
    "@chttp/val": "workspace:^",
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^24.0.0",
    "@valibot/to-json-schema": "^1.8.0",
    "typescript": "^5.9.0",
    "valibot": "^1.5.0"
  },
  "peerDependencies": {
    "@chttp/router": "workspace:^"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Joaquin Terrasa & contributors",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "json-rpc",
    "llm",
    "tools",
    "scriptc",
    "native"
  ],
  "homepage": "https://github.com/sigilco/chttp/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/sigilco/chttp/issues"
  },
  "sideEffects": false
}
