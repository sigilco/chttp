{
  "name": "@chttp/html",
  "version": "0.3.0",
  "description": "Minimal HTML string rendering (escape, h, html tag) authored inside the scriptc compilable subset",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sigilco/chttp.git",
    "directory": "packages/html"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/esm/jsx-runtime.d.ts",
      "import": "./dist/esm/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/esm/jsx-runtime.d.ts",
      "import": "./dist/esm/jsx-runtime.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/html.test.js test/jsx-runtime.test.js test/page.test.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Joaquin Terrasa & contributors",
  "keywords": [
    "html",
    "escape",
    "ssr",
    "template",
    "scriptc",
    "native"
  ],
  "homepage": "https://github.com/sigilco/chttp/tree/main/packages/html#readme",
  "bugs": {
    "url": "https://github.com/sigilco/chttp/issues"
  },
  "sideEffects": false
}
