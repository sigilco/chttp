  "engines": {
    "node": ">=22"
  },
  "author": "Joaquin Terrasa & contributors",
  "keywords": [
    "sse",
    "server-sent-events",
    "streaming",
    "http",
    "scriptc",
    "native"
  ],
  "homepage": "https://github.com/sigilco/chttp/tree/main/packages/stream#readme",
  "bugs": {
