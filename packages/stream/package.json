{
  "name": "@chttp/stream",
  "version": "0.4.0",
  "description": "Server-Sent Events and chunked text streaming for @chttp/router, authored inside the scriptc compilable subset",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sigilco/chttp.git",
    "directory": "packages/stream"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
